# Copy to .env. submit.py reads this file and takes no CLI flags.

# Hugging Face. Read access is needed for ILSVRC/imagenet-1k (gated: accept the
# terms on its page once); WRITE access is required by submit.py.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your model repo, e.g. yourname/perturb-effnetv2l (<= 44 chars for the chain payload)
HF_REPO_ID=
# Directory produced by train.py (model.safetensors + config.json)
MODEL_DIR=runs/v1/last

# Datasets used by train.py
IMAGENET_DATASET=ILSVRC/imagenet-1k
ADV_DATASET=perturb-ai/efficientnet-v2-l-adv-dataset

# Bittensor wallet used by submit.py
WALLET_NAME=miner
WALLET_HOTKEY=default
# WALLET_PATH=~/.bittensor/wallets
NETUID=26
SUBTENSOR_NETWORK=finney
